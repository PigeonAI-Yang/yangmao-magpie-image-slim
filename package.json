{
  "name": "yangmao-magpie-image-slim",
  "version": "0.1.4",
  "description": "Keep image-heavy Codex and DeepSeek Harness chats usable with Magpie previews, request budgets, and optional local image caching. Maintained by Yangmao.",
  "type": "module",
  "files": [
    "image-slim.middleware.js",
    "image-preview.hooks.mjs",
    "image-preview.py",
    "README.md",
    "README.en.md",
    "assets"
  ],
  "license": "MIT",
  "homepage": "https://ymtuan.live/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PigeonAI-Yang/yangmao-magpie-image-slim.git"
  },
  "keywords": [
    "magpie-plugin",
    "magpie",
    "codex",
    "image-history",
    "context-window"
  ],
  "magpie": {
    "name": "Yangmao · Image Slim",
    "summary": {
      "zh": "为 Codex 和 DeepSeek Harness 保留旧图预览，控制请求体积。支持本地缓存原图，由羊毛团维护。",
      "en": "Keep image previews in Codex and DeepSeek Harness chats, bound request size, and optionally cache originals locally. Maintained by Yangmao."
    },
    "icon": "https://raw.githubusercontent.com/PigeonAI-Yang/yangmao-magpie-image-slim/main/assets/yangmao-symbol.png",
    "middleware": "./image-slim.middleware.js",
    "hooks": "./image-preview.hooks.mjs",
    "options": {
      "request_budget_bytes": 70000000,
      "dsh_budget_bytes": 8000000,
      "trigger_bytes": 12582912,
      "preview_turns": 5,
      "gatewayTimeoutMs": 15000,
      "python_path": "python",
      "models": ["codex/*", "gpt-*", "chatgpt-*"]
    }
  }
}
